<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1>All reviews</h1>
    <%for(let review of reviews){%>
        <h4>Rating:</h4>
        <p><%= review.rating %></p>
        <h5>Comment</h5>
        <p><%= review.comment %></p>
        <p>By <%= review.author.username  %></p>

        <hr/>
   <% }%>
  </body>
</html>
